{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/features",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/documentation",
      "destination": "/vision",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
